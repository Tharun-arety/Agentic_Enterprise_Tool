# Copy to backend/.env and fill in. Never commit backend/.env.

# ---------------------------------------------------------------------------
# Neon Postgres  (required)
# ---------------------------------------------------------------------------
# Neon dashboard -> your project -> Connection Details -> Connection string.
#
# Paste it exactly as Neon gives it to you. db.py rewrites the scheme to
# postgresql+asyncpg://, strips libpq-only params such as ?sslmode=require that
# asyncpg cannot accept, and re-applies TLS through connect_args.
#
# Either endpoint works. The direct (non "-pooler") host is preferred for this
# backend: it keeps its own connection pool, so Neon's PgBouncer adds nothing.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# OpenAI  (optional until you want live agent answers)
# ---------------------------------------------------------------------------
# Leave OPENAI_API_KEY empty and the stack still runs: seeding, the BOM and QMS
# tools, the REST endpoints, and the whole frontend work against a deterministic
# local embedding fallback. Only /api/chat needs a real key.
#
# WARNING: with no key, knowledge search returns results in a stable but
# ARBITRARY order. It is not semantic ranking. Set the key and re-seed for real
# retrieval quality.
OPENAI_API_KEY=""
MODEL_PROVIDER="auto"

# Router + all three retrieval spokes. This path is intent classification and
# function calling over structured DB results, so the cheapest tier is the
# right tool, not just the affordable one.
OPENAI_MODEL="gpt-5-nano-2025-08-07"

# Optional. Applies to the final answer node only; falls back to OPENAI_MODEL
# when empty. Worth setting if you want better prose without paying for a
# larger model on every routing and tool call.
OPENAI_SYNTHESIS_MODEL=""

# Cheapest OpenAI embedding model (1536-dim). Changing this to a model of a
# different width requires updating EMBEDDING_DIMENSIONS in app/embeddings.py
# and re-running the seed script.
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# Symmetric signing key for access tokens. Leaving this unset falls back to a
# built-in development value that is public — anyone who has read this file can
# mint a token for any role, including admin. The API logs a warning at boot and
# /api/health reports secure_tokens=false while that is the case.
#
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=""
JWT_ALGORITHM="HS256"
JWT_EXPIRY_MINUTES=15
REFRESH_EXPIRY_DAYS=7
COOKIE_SECURE=false

# Password shared by every account the seed script creates. Demo data only.
DEMO_USER_PASSWORD="magnotherm"

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# Leave empty. The suite then starts its own PostgreSQL in-process from the
# `pgserver` wheel — server binaries and pgvector included — so `pytest` needs
# no database, no container and no daemon.
#
# That default is about speed, not convenience: the tests are thousands of tiny
# queries, and against a hosted database each one costs a network round trip.
# The same 92 tests take ~40 seconds locally and ~17 minutes over the wire.
#
# Set this to a Postgres URL to run against a remote database anyway. It is
# safe to point at the same database as DATABASE_URL: the suite builds and
# drops its own `mt_test` schema, and refuses to start if the tables do not
# land there.
TEST_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
# Comma-separated CORS allow-list. The browser-side chat fetch is subject to
# CORS, so this must include whatever port the UI actually runs on.
FRONTEND_ORIGIN="http://localhost:3001,http://localhost:3000"
API_HOST="127.0.0.1"
API_PORT=8000

# Hard ceiling on the tool-calling loop inside each agent spoke.
AGENT_MAX_TOOL_ITERATIONS=4
MODEL_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=15
AGENT_TOKEN_BUDGET=12000
REDIS_URL="redis://localhost:6379/0"
RATE_LIMIT_PER_MINUTE=120

BACKOFFICE_ADAPTER="local"
ERPNEXT_BASE_URL="http://erpnext:8080"
ERPNEXT_API_KEY=""
ERPNEXT_API_SECRET=""
FRAPPE_WEBHOOK_SECRET=""
